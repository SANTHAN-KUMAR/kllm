# OPTIONAL. LiteLLM is no longer needed: the relay serves OpenAI + Anthropic and checks gateway_api_key itself.
# Only for people who want LiteLLM's usage UI/routing. Needs `pip install 'kllm[litellm]'`, `litellm_enabled: true`
# and `kllm litellm-config`. Paths below assume a checkout at ~/kllm; edit them.
[Unit]
Description=kllm LiteLLM proxy — OpenAI/Anthropic gateway in front of the relay
After=network-online.target kllm-relay.service
Wants=kllm-relay.service

[Service]
Type=simple
Environment=KLLM_ROOT=%h/kllm
ExecStart=%h/kllm/.venv/bin/litellm --config %h/kllm/litellm/config.yaml --port 4000 --host 127.0.0.1
WorkingDirectory=%h/kllm
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
